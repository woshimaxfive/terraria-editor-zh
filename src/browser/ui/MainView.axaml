<UserControl xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:TEditBrowser" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TEditBrowser.MainView" FontFamily="avares://TEdit.Browser.UI/Assets#Noto Sans CJK SC" FontSize="12">
<UserControl.Resources><local:DisplayNameConverter x:Key="ChoiceText" /></UserControl.Resources><UserControl.Styles>
 <Style Selector="Button"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" /></Style>
 <Style Selector="TextBox"><Setter Property="MinHeight" Value="27" /><Setter Property="Padding" Value="5,3" /></Style>
 <Style Selector="ComboBox"><Setter Property="MinHeight" Value="27" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
 <Style Selector="TextBlock.panelTitle"><Setter Property="FontSize" Value="16" /><Setter Property="Margin" Value="0,4,0,10" /></Style>
 <Style Selector="TabItem"><Setter Property="MinHeight" Value="32" /><Setter Property="MinWidth" Value="36" /><Setter Property="Padding" Value="8,4" /></Style>
 <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>

 <Style Selector="StackPanel.toolRail > Button"><Setter Property="Padding" Value="3" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
 <Style Selector="Button.activeTool"><Setter Property="BorderBrush" Value="#50bd50" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="#283928" /></Style>
 <Style Selector="TabControl#DesktopTabs > TabItem"><Setter Property="Width" Value="46" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="8,4" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="#a5a8a8" /><Setter Property="ToolTip.Placement" Value="Left" /></Style>
 <Style Selector="TabControl#DesktopTabs > TabItem:selected"><Setter Property="Foreground" Value="#50bd50" /></Style>
 <Style Selector="TabControl#DesktopTabs">
  <Setter Property="Padding" Value="0" />
  <Setter Property="Template">
   <ControlTemplate>
    <DockPanel Background="{TemplateBinding Background}">
     <ScrollViewer x:Name="SidebarTabScroll" DockPanel.Dock="Right" Width="48" Background="#292929" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
     </ScrollViewer>
     <Panel ClipToBounds="True">
      <ContentPresenter Name="PART_SelectedContentHost2" Margin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
      <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
     </Panel>
    </DockPanel>
   </ControlTemplate>
  </Setter>
 </Style>
</UserControl.Styles>
<Grid Background="#202020" RowDefinitions="26,Auto,*,28">
 <Menu Background="#292929"><MenuItem Header="{DynamicResource menu_file}"><MenuItem Header="{DynamicResource menu_file_new}" Tag="new" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_file_open}" Tag="open" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_file_save}" Tag="export" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_file_saveas}" Tag="export" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_file_saveasversion}" Tag="version" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_language}"><MenuItem Header="{DynamicResource menu_language_en}" ToggleType="CheckBox" IsChecked="false" Tag="language:en" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_ru}" ToggleType="CheckBox" IsChecked="false" Tag="language:ru" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_ar}" ToggleType="CheckBox" IsChecked="false" Tag="language:ar" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_zh}" ToggleType="CheckBox" IsChecked="true" Tag="language:zh-Hans" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_pl}" ToggleType="CheckBox" IsChecked="false" Tag="language:pl" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_de}" ToggleType="CheckBox" IsChecked="false" Tag="language:de" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_pt}" ToggleType="CheckBox" IsChecked="false" Tag="language:pt" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_es}" ToggleType="CheckBox" IsChecked="false" Tag="language:es" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_fr}" ToggleType="CheckBox" IsChecked="false" Tag="language:fr" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_it}" ToggleType="CheckBox" IsChecked="false" Tag="language:it" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_ja}" ToggleType="CheckBox" IsChecked="false" Tag="language:ja" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_ko}" ToggleType="CheckBox" IsChecked="false" Tag="language:ko" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_language_zh_hant}" ToggleType="CheckBox" IsChecked="false" Tag="language:zh-Hant" Click="DesktopMenu" /></MenuItem><Separator /><MenuItem Header="{DynamicResource menu_help_settings}" Tag="settings" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_file_export_map_tiles}" Tag="mapTiles" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_file_update}" Tag="update" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_file_exit}" Tag="close" Click="DesktopMenu" /></MenuItem><MenuItem Header="{DynamicResource menu_edit}"><MenuItem Header="{DynamicResource menu_edit_undo}" Tag="undo" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_redo}" Tag="redo" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_edit_copy}" Tag="copy" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_cut}" Tag="cut" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_paste}" Tag="paste" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_edit_delete}" Tag="delete" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_edit_export_selection}" IsEnabled="{Binding CanExportSelection}"><MenuItem Header="{DynamicResource menu_edit_export_pixel_map}" Tag="selectionPng:1" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_export_quarter_texture}" Tag="selectionPng:4" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_export_half_texture}" Tag="selectionPng:8" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_edit_export_full_texture}" Tag="selectionPng:16" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_edit_export_map_tiles}" Tag="mapTiles" Click="DesktopMenu" /></MenuItem></MenuItem><MenuItem Header="{DynamicResource menu_layers}"><MenuItem Header="{DynamicResource menu_layers_textures}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowTextures" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_color_mode}"><MenuItem Header="{DynamicResource menu_layers_color_default}" ToggleType="CheckBox" IsChecked="true" Tag="color:Default" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_color_realistic}" ToggleType="CheckBox" IsChecked="false" Tag="color:Realistic" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_color_minimap}" ToggleType="CheckBox" IsChecked="false" Tag="color:Minimap" Click="DesktopMenu" /></MenuItem><MenuItem Header="{DynamicResource menu_layers_grid}" ToggleType="CheckBox" IsChecked="false" Tag="layer:ShowGrid" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_layers_backgrounds}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowBackgrounds" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_walls}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowWalls" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_tiles}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowTiles" Click="DesktopMenu" /><MenuItem Header="{DynamicResource tool_paint_coating}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowCoatings" Click="DesktopMenu" /><MenuItem Header="{DynamicResource show_glow_masks}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowGlowMasks" Click="DesktopMenu" /><MenuItem StaysOpenOnClick="True" Tag="glowIntensity"><MenuItem.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{DynamicResource light_glow_intensity}" /><Slider x:Name="MenuGlowIntensity" Width="90" Minimum="0" Maximum="1" Value="0.5" ValueChanged="GlowIntensityChanged" /></StackPanel></MenuItem.Header></MenuItem><MenuItem Header="{DynamicResource menu_layers_liquid}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowLiquid" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_layers_actuators}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowActuators" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_red}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowRedWires" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_blue}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowBlueWires" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_green}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowGreenWires" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_yellow}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowYellowWires" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_all}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowAllWires" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_wire_transparency}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowWireTransparency" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_layers_points}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowPoints" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_buff_radii}" ToggleType="CheckBox" IsChecked="false" Tag="layer:ShowBuffRadii" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_minimap_background}" ToggleType="CheckBox" IsChecked="true" Tag="layer:MinimapBackground" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_layers_world_border}" ToggleType="CheckBox" IsChecked="true" Tag="layer:ShowWorldBorder" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_layers_world_border_overlay}" ToggleType="CheckBox" IsChecked="false" Tag="layer:WorldBorderOverlay" Click="DesktopMenu" /><Separator /><MenuItem StaysOpenOnClick="True" Tag="textureVisibilityZoomLevel"><MenuItem.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{DynamicResource menu_layers_textures_visible}" /><Slider x:Name="MenuTextureThreshold" Tag="textureVisibilityZoomLevel" Width="90" Minimum="3" Maximum="10" Value="6" ValueChanged="RenderPreferenceChanged" /></StackPanel></MenuItem.Header></MenuItem><MenuItem StaysOpenOnClick="True" Tag="backgroundScaleZoom"><MenuItem.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{DynamicResource menu_layers_bg_scale}" /><Slider x:Name="MenuBackgroundScale" Tag="backgroundScaleZoom" Width="90" Minimum="7" Maximum="12" Value="9" ValueChanged="RenderPreferenceChanged" /></StackPanel></MenuItem.Header></MenuItem></MenuItem><MenuItem Header="{DynamicResource menu_plugins}" Tag="plugins" Click="DesktopMenu" /><MenuItem Header="调试"><MenuItem Header="显示 NBT 覆盖层" ToggleType="CheckBox" IsChecked="false" Tag="layer:ShowNbtOverlay" Click="DesktopMenu" /></MenuItem><MenuItem Header="{DynamicResource menu_help}"><MenuItem Header="{DynamicResource menu_help_wiki}" Tag="wiki" Click="DesktopMenu" /><MenuItem Header="{DynamicResource menu_help_log}" Tag="log" Click="DesktopMenu" /><Separator /><MenuItem Header="{DynamicResource menu_help_about}" Tag="about" Click="DesktopMenu" /></MenuItem></Menu>

 <Border Grid.Row="1" IsVisible="{Binding Editable}" BorderBrush="#3b3b3b" BorderThickness="0,1" Background="#292929"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="6" Margin="42,3,8,3"><TextBlock Text="工具" VerticalAlignment="Center" /><ComboBox Width="100" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool,Mode=TwoWay}" /><TextBlock Text="宽" VerticalAlignment="Center" /><TextBox Width="48" Text="{Binding BrushWidth,Mode=TwoWay}" /><TextBlock Text="高" VerticalAlignment="Center" /><TextBox Width="48" Text="{Binding BrushHeight,Mode=TwoWay}" /><CheckBox Content="方块" IsChecked="{Binding TileActive,Mode=TwoWay}" /><ComboBox Width="200" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="掩码" VerticalAlignment="Center" /><ComboBox Width="100" ItemsSource="{Binding MaskModes}" SelectedItem="{Binding SelectedMask,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ChoiceText}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="CAD" Tag="cad" Click="DesktopButton" x:Name="Toolbar_cad" /></StackPanel></ScrollViewer></Border>
 <Grid Grid.Row="2" x:Name="Workspace">
  <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="5" /><ColumnDefinition Width="440" MinWidth="320" MaxWidth="640" /></Grid.ColumnDefinitions>
  <ScrollViewer x:Name="ToolRail" Background="#292929" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
   <StackPanel Classes="toolRail" Spacing="2" Margin="2">
     <Button ToolTip.Tip="新建" Tag="new" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_new"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="打开" Tag="open" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_open"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="下载世界文件" Tag="export" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_export"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="放大" Tag="zoomIn" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_zoomIn"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="缩小" Tag="zoomOut" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_zoomOut"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="撤销" Tag="undo" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_undo"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="重做" Tag="redo" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_redo"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button x:Name="Toolbar_delete" ToolTip.Tip="删除选区" Tag="delete" Click="DesktopButton" Width="32" Height="30"><Path Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,21 L16,21 L17,7 M10,10 L10,18 M14,10 L14,18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" /></Button>
     <Button ToolTip.Tip="裁剪世界" Tag="crop" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_crop"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="扩展世界" Tag="expand" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_expand"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="复制" Tag="copy" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_copy"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="粘贴" Tag="paste" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_paste"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button ToolTip.Tip="贴图" Tag="textures" Click="DesktopButton" Width="32" Height="30" x:Name="Toolbar_textures"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Separator Margin="3,5" />
     <Button Tag="Arrow" ToolTip.Tip="检查对象" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Selection" ToolTip.Tip="选区" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Picker" ToolTip.Tip="吸管" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Pencil" ToolTip.Tip="铅笔" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Brush" ToolTip.Tip="笔刷" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Hammer" ToolTip.Tip="锤子" Click="ChooseDesktopTool" Width="32" Height="30"><Path Data="M3,3 L10,3 L15,8 L11,12 L7,8 L3,8 Z M12,11 L21,20 L18,23 L9,14" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="22" Height="22" Stretch="Uniform" /></Button>
     <Button Tag="Fill" ToolTip.Tip="填充" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Point" ToolTip.Tip="点位" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Sprite" ToolTip.Tip="家具" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Morph" ToolTip.Tip="生态转换" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
     <Button Tag="Paste" ToolTip.Tip="粘贴" Click="ChooseDesktopTool" Width="32" Height="30"><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Regular" FontSize="22" VerticalAlignment="Center" /></Button>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Column="1" RowDefinitions="*,Auto" Background="#202020">
   <local:TextureWorldControl x:Name="Map" Focusable="True" ClipToBounds="True" PointerWheelChanged="MapWheel" PointerExited="MapExited" PointerPressed="MapDown" PointerMoved="MapMove" PointerReleased="MapUp" PointerCaptureLost="MapCaptureLost" />
   <Border x:Name="WelcomePanel" Background="#202020" Padding="24">
    <StackPanel MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
     <TextBlock Text="开始编辑泰拉瑞亚世界" FontSize="24" TextWrapping="Wrap" />
     <TextBlock Text="打开 .wld 存档，或将文件拖到窗口中。模组世界请同时选择同名 .twld。" TextWrapping="Wrap" Foreground="#b8b8b8" />
     <WrapPanel><Button Content="打开世界文件" Tag="open" Click="DesktopButton" Margin="0,0,8,8" /><Button Content="新建世界" Tag="new" Click="DesktopButton" Margin="0,0,8,8" /><Button Content="创建练习世界" Tag="practice" Click="DesktopButton" Margin="0,0,8,8" /><Button Content="世界浏览器" Click="OpenWorldExplorer" Margin="0,0,0,8" /></WrapPanel>
     <TextBlock Text="Windows 存档通常位于 Documents / My Games / Terraria / Worlds。Steam 云存档可通过世界浏览器选择。" TextWrapping="Wrap" Foreground="#b8b8b8" />
     <TextBlock Text="存档在本机处理。保存本机进度用于恢复编辑，下载世界文件后可放回游戏存档目录。" TextWrapping="Wrap" Foreground="#b8b8b8" />
    </StackPanel>
   </Border>
   <StackPanel x:Name="MapNavigation" Grid.Row="1" Background="#292929" Spacing="4" Margin="4" IsVisible="False">
    <WrapPanel>
     <Button x:Name="PanButton" Content="平移" Tag="pan" Click="DesktopButton" ToolTip.Tip="拖动地图平移，选择工具返回绘制" />
     <Button Content="−" Tag="zoomOut" Click="DesktopButton" ToolTip.Tip="缩小" />
     <TextBlock x:Name="MapZoom" Text="100%" MinWidth="62" TextAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="每格 16 像素为 100%" />
     <Button Content="+" Tag="zoomIn" Click="DesktopButton" ToolTip.Tip="放大" />
     <Button Content="适应全图" Tag="fit" Click="DesktopButton" /><Button Content="出生点" Tag="spawn" Click="DesktopButton" />
    </WrapPanel>
    <TextBlock x:Name="MapHint" Text="空格 + 拖动或中键平移 · 滚轮缩放" TextWrapping="Wrap" Foreground="#b8b8b8" />
   </StackPanel>
  </Grid>
  <Grid Grid.Column="1"><Border x:Name="ExportProgressOverlay" IsVisible="False" Background="#70202020"><StackPanel Width="360" VerticalAlignment="Center" Spacing="16"><TextBlock x:Name="ExportProgressText" Text="正在导出" TextWrapping="Wrap" /><ProgressBar x:Name="ExportOverallProgress" Height="24" Foreground="#3C8CDC" Maximum="100" /><ProgressBar x:Name="ExportLayerProgress" Height="24" Foreground="#50B464" Maximum="100" /><Button Width="40" Height="40" Background="#B42828" Content="✕" HorizontalAlignment="Center" Click="CancelRenderExport" /></StackPanel></Border></Grid><GridSplitter Grid.Column="2" Background="#333333" ResizeDirection="Columns" />
  <Grid Grid.Column="3" RowDefinitions="Auto,*" Background="#252525"><Border Padding="8" BorderBrush="#3b3b3b" BorderThickness="0,0,0,1">
    <StackPanel Spacing="6">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DesktopTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Content="世界浏览器" Click="OpenWorldExplorer" x:Name="WorldExplorerButton" /></Grid>
     <Grid ColumnDefinitions="*,120" MinHeight="90"><Border Background="#202020" BorderBrush="#454545" BorderThickness="1"><Image x:Name="Minimap" Height="90" Stretch="Fill" PointerPressed="MinimapDown" /></Border><TextBlock Grid.Column="1" Text="{Binding DesktopSelection}" TextWrapping="Wrap" Margin="10,4,0,0" /></Grid>
     <TextBlock Text="{Binding SaveState}" TextWrapping="Wrap" Foreground="#d9cd9d" /><WrapPanel><Button Content="下载世界文件" Command="{Binding ExportCommand}" IsEnabled="{Binding Editable}" Margin="0,0,6,0" /><Button Content="保存本机进度" Command="{Binding SaveCommand}" IsEnabled="{Binding Editable}" ToolTip.Tip="将当前进度保存到此浏览器" /><Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" Margin="6,0,0,0" /></WrapPanel>
    </StackPanel>
   </Border><TabControl Grid.Row="1" x:Name="DesktopTabs" TabStripPlacement="Right" SelectedIndex="{Binding SidebarIndex,Mode=TwoWay}" SelectionChanged="DesktopTabChanged"><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></TabControl.ItemsPanel><TabItem ToolTip.Tip="{DynamicResource editor_tabs_worldproperties}" Tag="world"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_worldproperties}" /><TextBox Watermark="搜索世界属性" TextChanged="PropertySearch" IsEnabled="{Binding Editable}" />
    <StackPanel x:Name="WorldPropertiesEmpty" IsVisible="{Binding !Editable}" Spacing="10">
     <TextBlock Text="打开世界后可查看和编辑世界属性。" TextWrapping="Wrap" Foreground="#b8b8b8" />
     <Button Content="打开世界文件" Tag="open" Click="DesktopButton" HorizontalAlignment="Left" />
     <Grid ColumnDefinitions="100,*" RowDefinitions="32,32,32,32,32" IsEnabled="False">
      <TextBlock Text="世界名称" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" /><TextBox Grid.Column="1" Watermark="—" IsReadOnly="True" />
      <TextBlock Grid.Row="1" Text="世界 ID" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" /><TextBox Grid.Row="1" Grid.Column="1" Watermark="—" IsReadOnly="True" />
      <TextBlock Grid.Row="2" Text="世界 GUID" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" /><TextBox Grid.Row="2" Grid.Column="1" Watermark="—" IsReadOnly="True" />
      <TextBlock Grid.Row="3" Text="游戏版本" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" /><TextBox Grid.Row="3" Grid.Column="1" Watermark="—" IsReadOnly="True" />
      <TextBlock Grid.Row="4" Text="种子" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" /><TextBox Grid.Row="4" Grid.Column="1" Watermark="—" IsReadOnly="True" />
     </Grid>
    </StackPanel><StackPanel x:Name="WorldPropertiesContent" IsVisible="{Binding Editable}" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource sidebar_palette_tooltip}" Tag="palette"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="调色板" />
     <TextBlock x:Name="ActiveToolLabel" FontSize="16" />
     <TextBlock x:Name="ToolHelp" TextWrapping="Wrap" Foreground="#b8b8b8" />
     <Grid ColumnDefinitions="56,*" Margin="0,4"><Border Width="48" Height="48" Background="#202020" BorderBrush="#454545" BorderThickness="1"><Image x:Name="MaterialThumbnail" Width="40" Height="40" Stretch="Uniform" /></Border><TextBlock x:Name="SelectedMaterialLabel" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
     <TextBlock Text="列表色块使用地图颜色，材质预览可加载本机游戏贴图。" TextWrapping="Wrap" Foreground="#9a9a9a" /><TextBox Watermark="搜索方块名称、ID" Text="{Binding MaterialSearch,Mode=TwoWay}" /><ListBox Height="200" ItemsSource="{Binding FilteredMaterials}" SelectedItem="{Binding SelectedMaterial,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="28,*,44"><Border Width="20" Height="20" Background="{Binding Color}" BorderBrush="#777777" BorderThickness="1" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding Id}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#aaaaaa" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="PaletteFields" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_special}" Tag="special"><TabItem.Header><Path Data="M2 20H22V7C22 6.2 21.68 5.44 21.12 4.88C20.56 4.32 19.8 4 19 4H5C4.2 4 3.44 4.32 2.88 4.88C2.32 5.44 2 6.2 2 7V20M20 11H15V9H9V11H4V7C4 6.74 4.11 6.5 4.29 6.29C4.5 6.11 4.74 6 5 6H19C19.27 6 19.5 6.11 19.71 6.29C19.9 6.5 20 6.74 20 7V11M15 13H20V18H4V13H9L11 15H13L15 13M11 11H13V13H11V11Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=TabItem}}" Width="22" Height="22" Stretch="Uniform" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="箱子与告示牌" /><ComboBox x:Name="SpecialKind" SelectedIndex="0" SelectionChanged="SpecialKindChanged"><ComboBoxItem Content="箱子" /><ComboBoxItem Content="告示牌" /></ComboBox><StackPanel x:Name="SpecialContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_sprites}" Tag="sprites"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="家具与物体" /><Button Content="编辑精灵表……" Click="OpenSpriteEditor" x:Name="SpriteEditorButton" /><ComboBox x:Name="SpriteBiomeVariants" SelectionChanged="SpriteBiomeChanged" /><Image x:Name="SpriteThumbnail" Width="96" Height="96" /><TextBox Watermark="搜索家具、物体、ID" Text="{Binding SpriteSearch,Mode=TwoWay}" /><ListBox Height="340" ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite,Mode=TwoWay}" SelectionChanged="SpritePreviewChanged" /><Button Content="使用所选家具样式" Command="{Binding SelectSpriteCommand}" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_clipboard}" Tag="clipboard"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="剪贴板" /><Expander Header="浮动粘贴操作"><StackPanel Spacing="4">
    <TextBlock Text="先复制或导入模板，再选浮动粘贴工具点击地图。可拖动主体或边缘缩放，选定位置后接受粘贴。" TextWrapping="Wrap" />
    <Button Content="接受浮动粘贴" Command="{Binding FloatingAcceptCommand}" /><Button Content="取消浮动" Command="{Binding FloatingCancelCommand}" />
    <Button Content="按粘贴坐标移动浮动层" Command="{Binding FloatingAnchorCommand}" />
    <NumericUpDown x:Name="FloatingWidthInput" Value="{Binding FloatingWidth}" Minimum="1" Maximum="20160000" /><NumericUpDown x:Name="FloatingHeightInput" Value="{Binding FloatingHeight}" Minimum="1" Maximum="20160000" />
    <Button Content="缩放浮动模板" Command="{Binding FloatingResizeCommand}" />
    <Button Content="旋转浮动模板" Command="{Binding FloatingRotateCommand}" /><Button Content="翻转浮动模板左右" Command="{Binding FloatingFlipXCommand}" /><Button Content="翻转浮动模板上下" Command="{Binding FloatingFlipYCommand}" />
   </StackPanel></Expander><TextBlock Text="建筑模板与复制" Margin="0,0,0,8" />
   <CheckBox Content="地图拖动框选" IsChecked="{Binding SelectMode, Mode=TwoWay}" />
   <TextBlock Text="选区 X / Y / 宽 / 高" />
   <StackPanel Orientation="Horizontal"><TextBox Width="62" Text="{Binding SelectionX, Mode=TwoWay}" /><TextBox Width="62" Text="{Binding SelectionY, Mode=TwoWay}" /><TextBox Width="62" Text="{Binding SelectionWidth, Mode=TwoWay}" /><TextBox Width="62" Text="{Binding SelectionHeight, Mode=TwoWay}" /></StackPanel>
   <StackPanel Orientation="Horizontal"><Button Content="复制区域" Command="{Binding CopyCommand}" /><Button Content="导入模板" Command="{Binding ImportTemplateCommand}" /></StackPanel>
   <TextBlock Text="{Binding ClipboardStatus}" Height="44" TextWrapping="Wrap" Margin="0,5" />
   <StackPanel Orientation="Horizontal"><Button Content="水平翻转" Command="{Binding FlipXCommand}" /><Button Content="垂直翻转" Command="{Binding FlipYCommand}" /></StackPanel>
   <CheckBox Content="允许旋转移除家具及其数据" IsChecked="{Binding AllowSpriteRemoval, Mode=TwoWay}" />
   <StackPanel Orientation="Horizontal"><Button Content="旋转90°" Command="{Binding RotateCommand}" /><Button Content="导出模板" Command="{Binding ExportTemplateCommand}" /></StackPanel>
   <TextBlock Text="粘贴位置 X / Y" Margin="0,8,0,0" />
   <StackPanel Orientation="Horizontal"><TextBox Width="100" Text="{Binding PasteX, Mode=TwoWay}" /><TextBox Width="100" Text="{Binding PasteY, Mode=TwoWay}" /></StackPanel>
   <WrapPanel><CheckBox Content="空白" IsChecked="{Binding PasteEmpty, Mode=TwoWay}" /><CheckBox Content="方块" IsChecked="{Binding PasteTiles, Mode=TwoWay}" /><CheckBox Content="墙" IsChecked="{Binding PasteWalls, Mode=TwoWay}" /><CheckBox Content="液体" IsChecked="{Binding PasteLiquids, Mode=TwoWay}" /><CheckBox Content="电线" IsChecked="{Binding PasteWires, Mode=TwoWay}" /><CheckBox Content="家具" IsChecked="{Binding PasteSprites, Mode=TwoWay}" /><CheckBox Content="覆盖已有" IsChecked="{Binding PasteOverTiles, Mode=TwoWay}" /></WrapPanel>
   <Button Content="粘贴到坐标" Command="{Binding PasteCommand}" HorizontalAlignment="Left" />
   <Button Content="旧模板按当前世界 ID 绑定" Command="{Binding BindLegacyCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="仅无名称的旧模板可绑定；请确认其模组与当前世界的 ID 顺序一致。" TextWrapping="Wrap" Margin="0,5" />
   <Button Content="保存变化报告" Command="{Binding ReportCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="复制时过滤（沿用原版字段规则）" Margin="0,8,0,0" />
   <WrapPanel><CheckBox Content="方块" IsChecked="{Binding FilterTiles, Mode=TwoWay}" /><CheckBox Content="墙" IsChecked="{Binding FilterWalls, Mode=TwoWay}" /><CheckBox Content="液体" IsChecked="{Binding FilterLiquids, Mode=TwoWay}" /><CheckBox Content="电线" IsChecked="{Binding FilterWires, Mode=TwoWay}" /></WrapPanel>
   <Button Content="刷新本机恢复列表" Command="{Binding RecoveriesCommand}" HorizontalAlignment="Left" />
   <ComboBox ItemsSource="{Binding Recoveries}" SelectedItem="{Binding SelectedRecovery, Mode=TwoWay}" HorizontalAlignment="Stretch" />
   <StackPanel Orientation="Horizontal"><Button Content="恢复所选" Command="{Binding RestoreSelectedCommand}" /><Button Content="删除所选记录" Command="{Binding DeleteSelectedCommand}" /></StackPanel>
   <TextBlock Text="本机模板库" Margin="0,8,0,0" />
   <TextBox Text="{Binding TemplateTitle, Mode=TwoWay}" Watermark="模板名称" />
   <StackPanel Orientation="Horizontal"><Button Content="存入模板库" Command="{Binding LibrarySaveCommand}" /><Button Content="刷新模板库" Command="{Binding LibraryListCommand}" /></StackPanel>
   <TextBox Text="{Binding TemplateSearch, Mode=TwoWay}" Watermark="按名称筛选模板" />
   <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
   <StackPanel Orientation="Horizontal"><Button Content="使用所选模板" Command="{Binding LibraryLoadCommand}" /><Button Content="删除所选模板" Command="{Binding LibraryDeleteCommand}" /></StackPanel>
   <TextBlock Text="选区编辑" Margin="0,8,0,0" />
   <StackPanel Orientation="Horizontal"><Button Content="剪切选区" Command="{Binding CutCommand}" /><Button Content="删除选区" Command="{Binding DeleteCommand}" /></StackPanel>
   </StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_npc}" Tag="npc"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_npc}" /><Button Content="重新载入" Tag="npc" Click="RefreshDesktopPanel" /><StackPanel x:Name="NpcContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_analysis}" Tag="analysis"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_analysis}" /><Button Content="重新载入" Tag="analysis" Click="RefreshDesktopPanel" /><StackPanel x:Name="AnalysisContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource tool_bestiary_title}" Tag="bestiary"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource tool_bestiary_title}" /><Button Content="重新载入" Tag="bestiary" Click="RefreshDesktopPanel" /><StackPanel x:Name="BestiaryContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_banners}" Tag="banners"><TabItem.Header><Path Data="M 0 0 V -10 H 6 V 0 L 3 -4 L 0 0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=TabItem}}" Width="22" Height="22" Stretch="Uniform" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_banners}" /><Button Content="重新载入" Tag="banners" Click="RefreshDesktopPanel" /><StackPanel x:Name="BannersContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_tileentities}" Tag="entity"><TabItem.Header><Path Data="M 18.33 7.78 A 1 1 0 0 0 16.66 8.89 A 2 2 0 1 1 13 10 V 7.82 A 3 3 0 1 0 11 7.82 V 14 A 2 2 0 1 1 7.34 12.89 A 1 1 0 1 0 5.67 11.78 A 4 4 0 0 0 11 17.46 V 20 A 2 2 0 0 0 9 22 H 15 A 2 2 0 0 0 13 20 V 13.46 A 4 4 0 0 0 18.33 7.78 M 12 4 A 1 1 0 1 1 11 5 A 1 1 0 0 1 12 4 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=TabItem}}" Width="22" Height="22" Stretch="Uniform" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_tileentities}" /><Button Content="重新载入" Tag="entity" Click="RefreshDesktopPanel" /><StackPanel x:Name="EntityContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource editor_tabs_creative}" Tag="creative"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource editor_tabs_creative}" /><Button Content="重新载入" Tag="creative" Click="RefreshDesktopPanel" /><StackPanel x:Name="CreativeContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource sidebar_filter_tooltip}" Tag="filter"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="显示筛选" /><StackPanel x:Name="FilterFields" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource sidebar_find_tooltip}" Tag="find"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="查找" /><ComboBox x:Name="FindKind" SelectedIndex="0"><ComboBoxItem Content="方块" /><ComboBoxItem Content="墙壁" /><ComboBoxItem Content="箱内物品" /><ComboBoxItem Content="家具" /></ComboBox><TextBox x:Name="FindIds" Watermark="ID，多个用逗号分隔" /><Button Content="查找" Click="DesktopFind" /><ListBox x:Name="FindResults" Height="460" SelectionChanged="FindResultSelected" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource sidebar_scripting_tooltip}" Tag="scripts"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"><TextBlock Classes="panelTitle" Text="脚本" /><WrapPanel Grid.Row="1"><ComboBox x:Name="ScriptLanguage" SelectionChanged="ScriptLanguageChanged" Width="110" SelectedIndex="0"><ComboBoxItem Content="JavaScript" /><ComboBoxItem Content="Lua" /></ComboBox><Button Content="运行" Click="RunDesktopScript" /><Button Content="停止" Command="{Binding CancelCommand}" /><TextBlock Text="时限（秒）" /><TextBox x:Name="ScriptTimeout" Width="45" Text="10" /></WrapPanel><WrapPanel Grid.Row="2"><Button Content="导入" Click="ImportScripts" /><Button Content="导出/保存" Click="ExportScript" /><Button Content="本机库" Click="OpenScriptLibrary" /><Button Content="API" Click="ShowScriptApi" /></WrapPanel><StackPanel Grid.Row="3"><TextBox x:Name="ScriptName" Text="script.js" /><ComboBox x:Name="ScriptExamples" PlaceholderText="原版示例" SelectionChanged="ScriptExampleChanged" /></StackPanel><local:ScriptCodeEditor Grid.Row="4" x:Name="ScriptEditor" ShowLineNumbers="True" FontFamily="avares://TEdit.Browser.UI/Assets#Noto Sans CJK SC" Background="#171717" Foreground="#ddd" MinHeight="220" Height="300" Text="// 使用原版 TEdit API&#10;log.print(world.title);" /><TextBox Grid.Row="5" x:Name="ScriptLog" IsReadOnly="True" AcceptsReturn="True" Height="150" TextWrapping="Wrap" /><ListBox Grid.Row="6" x:Name="ScriptFound" MaxHeight="160" SelectionChanged="FindResultSelected" /></Grid></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource nbt_explorer_title}" Tag="nbt"><TabItem.Header><TextBlock Text="" FontFamily="avares://TEdit.Browser.UI/Assets#FluentSystemIcons-Filled" FontSize="22" VerticalAlignment="Center" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="{DynamicResource nbt_explorer_title}" /><Button Content="重新载入" Tag="nbt" Click="RefreshDesktopPanel" /><StackPanel x:Name="NbtContent" /></StackPanel></ScrollViewer></Border></TabItem><TabItem ToolTip.Tip="{DynamicResource player_editor_tooltip}" Tag="player"><TabItem.Header><Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=TabItem}}" Width="22" Height="22" Stretch="Uniform" /></TabItem.Header><Border Padding="12,6"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="玩家编辑器" /><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="打开 .plr" Click="OpenPlayer" /><Button Content="导出 .plr" Click="SavePlayer" /></StackPanel><TextBlock x:Name="PlayerStatus" Text="请选择玩家文件" TextWrapping="Wrap" /><StackPanel x:Name="PlayerContent" /></StackPanel></ScrollViewer></Border></TabItem></TabControl></Grid>
 </Grid>
 <Border Grid.Row="3" Background="#292929" BorderBrush="#3b3b3b" BorderThickness="0,1,0,0">
  <Grid ColumnDefinitions="*,Auto" Margin="4,0">
   <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="坐标" /><TextBox x:Name="HoverPosition" IsReadOnly="True" Width="75" /><TextBlock Text="深度" /><TextBox x:Name="HoverDepth" IsReadOnly="True" Width="130" /><TextBlock Text="方块" /><TextBox x:Name="HoverTile" IsReadOnly="True" Width="115" /><TextBlock Text="墙壁" /><TextBox x:Name="HoverWall" IsReadOnly="True" Width="115" /><TextBlock Text="附加" /><TextBox x:Name="HoverExtra" IsReadOnly="True" Width="95" /><TextBlock Text="帧" /><TextBox x:Name="HoverUV" IsReadOnly="True" Width="60" DoubleTapped="OpenUvEditorTapped" /><TextBlock Text="油漆" /><TextBox x:Name="HoverPaint" IsReadOnly="True" Width="110" /></StackPanel></ScrollViewer>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
    <TextBlock Text="{Binding Status}" x:Name="OperationStatus" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" VerticalAlignment="Center" />
    <TextBlock x:Name="RenderStatusLabel" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <ProgressBar Width="90" Height="6" IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}" />
   </StackPanel>
  </Grid>
 </Border>
 <Border x:Name="DesktopDialog" Grid.RowSpan="4" Background="#D9101010" IsVisible="False" Padding="100,40"><Border Background="#292929" Padding="20" MaxWidth="900"><DockPanel><Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="关闭" Click="CloseDesktopDialog" /><Border x:Name="NewWorldFooter" DockPanel.Dock="Bottom" IsVisible="False" Padding="0,12,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Grid.Column="1" Content="创建新世界" Command="{Binding NewWorldCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Right" /></Grid></Border><ScrollViewer><StackPanel x:Name="DesktopDialogContent" Spacing="8"><StackPanel Tag="new"><Expander Header="按原版创建新世界"><StackPanel Spacing="4">
 <TextBlock Text="名称" /><TextBox Text="{Binding NewWorldTitle}" x:Name="Form_NewWorldTitle" />
 <TextBlock Text="宽、高" /><NumericUpDown Value="{Binding NewWorldWidth}" Minimum="100" Maximum="8400" x:Name="Form_NewWorldWidth" /><NumericUpDown Value="{Binding NewWorldHeight}" Minimum="250" Maximum="2400" x:Name="Form_NewWorldHeight" />
 <TextBlock Text="地表、岩层、山丘高度" /><NumericUpDown Value="{Binding NewWorldGround}" Minimum="10" Maximum="2000" x:Name="Form_NewWorldGround" /><NumericUpDown Value="{Binding NewWorldRock}" Minimum="20" Maximum="2300" x:Name="Form_NewWorldRock" /><NumericUpDown Value="{Binding NewWorldHill}" Minimum="0" Maximum="1000" x:Name="Form_NewWorldHill" />
 <TextBlock Text="种子" /><TextBox Text="{Binding NewWorldSeed}" x:Name="Form_NewWorldSeed" />
 <CheckBox Content="生成草地" IsChecked="{Binding NewWorldGrass}" x:Name="Form_NewWorldGrass" /><CheckBox Content="生成墙壁" IsChecked="{Binding NewWorldWalls}" x:Name="Form_NewWorldWalls" /><CheckBox Content="生成洞穴" IsChecked="{Binding NewWorldCaves}" x:Name="Form_NewWorldCaves" /><CheckBox Content="生成地狱" IsChecked="{Binding NewWorldUnderworld}" x:Name="Form_NewWorldUnderworld" />
 <StackPanel Spacing="6">
<TextBlock Text="世界 ID" /><NumericUpDown Value="{Binding NewWorldId}" Minimum="0" Maximum="2147483647" x:Name="Form_NewWorldId" />
<Expander Header="洞穴与地狱参数"><StackPanel Spacing="5">
<CheckBox Content="地表洞穴" IsChecked="{Binding NewWorldSurfaceCaves}" x:Name="Form_NewWorldSurfaceCaves" />
<TextBlock Text="洞穴预设" /><ComboBox SelectionChanged="NewWorldCavePreset"><ComboBoxItem Content="普通" /><ComboBoxItem Content="大型" /><ComboBoxItem Content="迷宫" /></ComboBox>
<TextBlock Text="洞穴噪声 / 倍率 / 密度" /><NumericUpDown Value="{Binding NewWorldCaveNoise}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" x:Name="Form_NewWorldCaveNoise" /><NumericUpDown Value="{Binding NewWorldCaveMultiplier}" Minimum="0" Maximum="2" Increment="0.01" FormatString="0.00" x:Name="Form_NewWorldCaveMultiplier" /><NumericUpDown Value="{Binding NewWorldCaveDensity}" Minimum="0" Maximum="10" Increment="0.1" FormatString="0.0" x:Name="Form_NewWorldCaveDensity" />
<CheckBox Content="生成灰烬" IsChecked="{Binding NewWorldAsh}" x:Name="Form_NewWorldAsh" /><CheckBox Content="生成熔岩" IsChecked="{Binding NewWorldLava}" x:Name="Form_NewWorldLava" />
<TextBlock Text="地狱顶部 / 底部 / 熔岩噪声" /><NumericUpDown Value="{Binding NewWorldRoofNoise}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" x:Name="Form_NewWorldRoofNoise" /><NumericUpDown Value="{Binding NewWorldFloorNoise}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" x:Name="Form_NewWorldFloorNoise" /><NumericUpDown Value="{Binding NewWorldLavaNoise}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" x:Name="Form_NewWorldLavaNoise" />
</StackPanel></Expander><CheckBox Content="创建后打开矿石生成器" IsChecked="{Binding NewWorldOres}" x:Name="Form_NewWorldOres" />
</StackPanel>
 </StackPanel></Expander></StackPanel><StackPanel Tag="version"><TextBlock Text="另存为指定游戏版本" Margin="0,8,0,0" />
   <ComboBox ItemsSource="{Binding SaveVersions}" SelectedItem="{Binding TargetVersion, Mode=TwoWay}" x:Name="Form_TargetVersion" />
   <CheckBox Content="保留超出目标版本的内容" IsChecked="{Binding PreserveVersionContent, Mode=TwoWay}" />
   <Button Content="导出版本副本" Command="{Binding ExportVersionCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="降级沿用原版规则，可能删减内容；请保留原始副本。" TextWrapping="Wrap" />
   </StackPanel><StackPanel Tag="artifacts"><Expander Header="图片、玩家地图与回放"><StackPanel Spacing="4">
    <TextBlock Text="像素画间距" /><NumericUpDown Value="{Binding PixelSpacing}" Minimum="1" Maximum="32" />
    <ComboBox ItemsSource="{Binding PixelScalings}" SelectedItem="{Binding PixelScaling,Mode=TwoWay}" />
    <ComboBox ItemsSource="{Binding PixelRotations}" SelectedItem="{Binding PixelRotation,Mode=TwoWay}" />
    <CheckBox Content="方块" IsChecked="{Binding PixelTiles}" /><CheckBox Content="墙壁" IsChecked="{Binding PixelWalls}" />
    <CheckBox Content="建筑安全材料" IsChecked="{Binding PixelSafe}" /><CheckBox Content="去除重复颜色" IsChecked="{Binding PixelUnique}" />
    <CheckBox Content="透明背景参与采样" IsChecked="{Binding PixelBackdrop}" /><CheckBox Content="Y 轴排列" IsChecked="{Binding PixelYAxis}" />
    <TextBlock Text="Lanczos 半径" /><NumericUpDown Value="{Binding PixelLanczosA}" Minimum="1" Maximum="8" />
    <TextBlock Text="Gaussian sigma" /><NumericUpDown Value="{Binding PixelSigma}" Minimum="0.01" Maximum="10" Increment="0.1" />
    <Button Content="导入图片生成模板" Command="{Binding PixelImportCommand}" />
    <Button Content="导出玩家 .map" Command="{Binding PlayerMapCommand}" />
    <Button Content="打开 .terp 回放" Command="{Binding ReplayImportCommand}" />
    <Button Content="导出当前图格历史回放" Command="{Binding ReplayExportCommand}" />
    <Button Content="导出已录制的回放" Command="{Binding RecordingExportCommand}" />
   </StackPanel></Expander>
   </StackPanel></StackPanel></ScrollViewer></DockPanel></Border></Border>
</Grid></UserControl>
